[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- LOG STOK: Trigger untuk tracking perubahan stok[m
[32m+[m[32m-- Tabel log_stok sudah ada (line 108-114)[m
[32m+[m[32m-- kode_aksi: 1 = MASUK (restock), 2 = KELUAR (penjualan)[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- Trigger function: otomatis jalan setiap kali stok berubah[m
[32m+[m[32mCREATE OR REPLACE FUNCTION fn_log_perubahan_stok()[m
[32m+[m[32mRETURNS TRIGGER AS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m    v_kode_aksi INT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    -- Skip jika stok tidak berubah[m
[32m+[m[32m    IF NEW.stok = OLD.stok THEN[m
[32m+[m[32m        RETURN NEW;[m
[32m+[m[32m    END IF;[m
[32m+[m[41m    [m
[32m+[m[32m    -- Tentukan kode aksi: 1 = masuk (stok naik), 2 = keluar (stok turun)[m
[32m+[m[32m    IF NEW.stok > OLD.stok THEN[m
[32m+[m[32m        v_kode_aksi := 1;  -- MASUK (restock)[m
[32m+[m[32m    ELSE[m
[32m+[m[32m        v_kode_aksi := 2;  -- KELUAR (penjualan)[m
[32m+[m[32m    END IF;[m
[32m+[m[41m    [m
[32m+[m[32m    -- Insert ke log_stok (sesuai schema line 108-114)[m
[32m+[m[32m    INSERT INTO log_stok (jumlah_stok, kode_aksi, updated_at, id_produk)[m
[32m+[m[32m    VALUES ([m
[32m+[m[32m        ABS(NEW.stok - OLD.stok),  -- jumlah perubahan (selalu positif)[m
[32m+[m[32m        v_kode_aksi,[m
[32m+[m[32m        CURRENT_DATE,[m
[32m+[m[32m        NEW.id_produk[m
[32m+[m[32m    );[m
[32m+[m[41m    [m
[32m+[m[32m    RETURN NEW;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$ LANGUAGE plpgsql;[m
[32m+[m
[32m+[m[32m-- Pasang trigger ke tabel produk[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_log_stok ON produk;[m
[32m+[m[32mCREATE TRIGGER trg_log_stok[m
[32m+[m[32m    AFTER UPDATE OF stok ON produk[m
[32m+[m[32m    FOR EACH ROW[m
