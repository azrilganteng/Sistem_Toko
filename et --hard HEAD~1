[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- PROCEDURE: Transaksi Penjualan (ACID Transaction)[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- Atomicity:   Semua operasi (order + pengiriman) terjadi sebagai satu kesatuan.[m
[32m+[m[32m--              Jika salah satu gagal, semua di-rollback.[m
[32m+[m[32m-- Consistency: Memastikan id_customer, id_user, dan id_pengiriman valid[m
[32m+[m[32m--              sesuai constraint database.[m
[32m+[m[32m-- Isolation:   Berjalan dalam transaction context dari pemanggil,[m
[32m+[m[32m--              tidak terganggu transaksi lain.[m
[32m+[m[32m-- Durability:  Setelah COMMIT dari pemanggil, data permanen.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32m-- Procedure: Transaksi Penjualan Lengkap (ACID)[m
[32m+[m[32m-- Atomicity:   Order + pengiriman + detail + stok dalam 1 procedure.[m
[32m+[m[32m-- Consistency: Constraint database menjaga validitas data.[m
[32m+[m[32m-- Isolation:   Berjalan dalam transaction context dari pemanggil.[m
[32m+[m[32m-- Durability:  Setelah COMMIT dari pemanggil, data permanen.[m
[32m+[m[32m--[m
[32m+[m[32m-- Catatan: id_pengiriman di tabel orders harus nullable:[m
[32m+[m[32m-- ALTER TABLE orders ALTER COLUMN id_pengiriman DROP NOT NULL;[m
[32m+[m[32m--[m
[32m+[m[32mCREATE OR REPLACE PROCEDURE p_transaksi_penjualan([m
[32m+[m[32m    p_id_user           INT,            -- Kasir ID[m
[32m+[m[32m    p_id_customer       INT,            -- Customer ID[m
[32m+[m[32m    p_metode_bayar      BOOLEAN,        -- true = Cash, false = Transfer[m
[32m+[m[32m    OUT p_id_order      INT,[m
[32m+[m[32m    p_id_kurir          INT DEFAULT NULL, -- Kurir ID (NULL = Langsung, ada value = Dikirim)[m
[32m+[m[32m    p_produk_ids        INT[] DEFAULT NULL,  -- Array: id_produk[m
[32m+[m[32m    p_produk_jumlahs    INT[] DEFAULT NULL,  -- Array: jumlah[m
[32m+[m[32m    p_produk_hargas     NUMERIC[] DEFAULT NULL -- Array: harga[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m    v_id_pengiriman INT := NULL;[m
[32m+[m[32m    v_subtotal      NUMERIC;[m
[32m+[m[32m    v_stok          INT;[m
[32m+[m[32m    v_is_kurir      BOOLEAN;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    -- STEP 1: Buat pengiriman (hanya jika ada kurir / Dikirim)[m
[32m+[m[32m    -- Langsung = tidak insert pengiriman, id_pengiriman = NULL[m
[32m+[m[32m    -- Validasi: kurir harus ada di users dengan role Kurir[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    IF p_id_kurir IS NOT NULL THEN[m
[32m+[m[32m        -- Cek apakah user ini adalah kurir (validasi dari tabel users + kewenangan)[m
[32m+[m[32m        SELECT EXISTS([m
[32m+[m[32m            SELECT 1 FROM users u[m
[32m+[m[32m            JOIN kewenangan k USING(id_user)[m
[32m+[m[32m            WHERE u.id_user = p_id_kurir[m
[32m+[m[32m              AND k.id_role = 3[m
[32m+[m[32m              AND u.is_active = true[m
[32m+[m[32m              AND u.is_ready = true[m
[32m+[m[32m        ) INTO v_is_kurir;[m
[32m+[m
[32m+[m[32m        IF NOT v_is_kurir THEN[m
[32m+[m[32m            RAISE EXCEPTION 'User ID % bukan kurir yang valid atau tidak ready', p_id_kurir;[m
[32m+[m[32m        END IF;[m
[32m+[m
[32m+[m[32m        INSERT INTO pengiriman (tanggal_kirim, status_pengiriman, id_user)[m
[32m+[m[32m        VALUES (CURRENT_DATE, false, p_id_kurir)[m
[32m+[m[32m        RETURNING id_pengiriman INTO v_id_pengiriman;[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    -- STEP 2: Buat order[m
[32m+[m[32m    -- Tidak ada kolom metode_kirim di database.[m
[32m+[m[32m    -- Langsung: id_pengiriman = NULL[m
[32m+[m[32m    -- Dikirim:  id_pengiriman = v_id_pengiriman[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    INSERT INTO orders (tanggal_order, status, metode_pembayaran,[m
[32m+[m[32m                        tanggal_bayar, id_user, id_customer, id_pengiriman)[m
[32m+[m[32m    VALUES (CURRENT_DATE, false, p_metode_bayar,[m
[32m+[m[32m            CURRENT_DATE, p_id_user, p_id_customer, v_id_pengiriman)[m
[32m+[m[32m    RETURNING id_order INTO p_id_order;[m
[32m+[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    -- STEP 3: Tambah detail order + kurangi stok[m
[32m+[m[32m    -- Cek stok dulu, RAISE EXCEPTION jika tidak cukup[m
[32m+[m[32m    -- ============================================================[m
[32m+[m[32m    IF p_produk_ids IS NOT NULL THEN[m
[32m+[m[32m        FOR i IN 1..array_length(p_produk_ids, 1) LOOP[m
[32m+[m[32m            v_subtotal := p_produk_jumlahs[i] * p_produk_hargas[i];[m
[32m+[m
[32m+[m[32m            -- Cek stok (Consistency: stok tidak boleh negatif)[m
[32m+[m[32m            SELECT stok INTO v_stok FROM produk WHERE id_produk = p_produk_ids[i];[m
[32m+[m[32m            IF v_stok < p_produk_jumlahs[i] THEN[m
[32m+[m[32m                RAISE EXCEPTION 'Stok tidak cukup untuk produk ID %. Tersedia: %, Diminta: %',[m
[32m+[m[32m                    p_produk_ids[i], v_stok, p_produk_jumlahs[i];[m
[32m+[m[32m            END IF;[m
[32m+[m
[32m+[m[32m            -- Insert detail[m
[32m+[m[32m            INSERT INTO detail_orders (id_order, id_produk, jumlah, harga)[m
[32m+[m[32m            VALUES (p_id_order, p_produk_ids[i], p_produk_jumlahs[i], v_subtotal);[m
[32m+[m
[32m+[m[32m            -- Kurangi stok[m
[32m+[m[32m            UPDATE produk[m
[32m+[m[32m            SET stok = stok - p_produk_jumlahs[i][m
[32m+[m[32m            WHERE id_produk = p_produk_ids[i];[m
[32m+[m[32m        END LOOP;[m
[32m+[m[32m    END IF;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
